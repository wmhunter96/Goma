(version 1)

# Headers and sockets deliberately sit side by side on the 2.54 mm grid (servo blocks, and the
# I/O + OLED headers 2.8 mm from the DevKit socket row). Their plastic bodies clear each other
# (audit.py checks the real gaps); only KiCad's courtyard margins overlap.
(rule "side-by-side 2.54mm headers"
  (constraint courtyard_clearance (min 0mm))
  (condition "(A.Reference == 'S?' || A.Reference == 'J?') && (B.Reference == 'S?' || B.Reference == 'J?')")
  (severity ignore))

# The Pololu module's own M2 holes (HP1/HP2) sit beside its 5-pin header by Pololu's design; a ~4 mm
# standoff at HP1 still clears the header plastic. Only the courtyard margins overlap.
(rule "Pololu holes beside its header"
  (constraint courtyard_clearance (min 0mm))
  (condition "(A.Reference == 'U1' && B.Reference == 'HP?') || (A.Reference == 'HP?' && B.Reference == 'U1')")
  (severity ignore))
